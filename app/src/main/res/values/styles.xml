<resources>
    <!-- Thème de l'application mis à jour par YOUSRI Ayoub -->
    <style name="AppTheme" parent="Theme.AppCompat.NoActionBar">
        <!-- Police système moderne -->
        <item name="android:fontFamily">sans-serif-medium</item>

        <!-- Barre de statut sombre pour aller avec le fond sombre -->
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:statusBarColor">@color/screen_bg_start</item>
        <item name="android:navigationBarColor">@color/screen_bg_end</item>

        <!-- Couleurs d'accentuation -->
        <item name="colorAccent">@color/accent_blue</item>
        <item name="android:windowNoTitle">true</item>
    </style>
</resources>
